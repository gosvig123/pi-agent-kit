#!/usr/bin/env node
// Cross-provider CLI for the shared review-findings store (~/.pi/agent/review-findings/<slug>/).
// Lets Claude Code, Codex, and Antigravity record and merge review findings alongside Pi.
import { parseArgs } from "node:util";
import {
	DECISIONS,
	ORIGINS,
	VERDICTS,
	SEVERITIES,
	appendFinding,
	existingLedger,
	groupOf,
	mergeFindings,
	readFindings,
	recordTriage,
	renderFindingsReport,
	recordVerdict,
	renderLedger,
} from "../lib/review-findings-store.ts";
import { collectStats, renderStats } from "../lib/review-stats.ts";

const USAGE = `Usage:
  review-finding add --brief <slug> --severity P0|P1|P2 --origin diff|existing \\
    --file <path> [--line <n>] --title <text> --proof <text> [--fix <text>] [--angle <name>] [--reviewer <id>]
  review-finding merge <slug> [--since <iso>] [--json]
  review-finding existing <group|slug> [--json] [--check]
  review-finding triage <group|slug> <id> fix-here|split-pr|file|drop [--note <text>]
  review-finding verdict <slug> <id> block|cheap-fix|noise [--note <text>]
  review-finding stats [--json]

A review group is a slug plus its later rounds, named <slug>-r<N>. "existing" lists the
pre-existing findings of all rounds with their triage status; --check exits 2 while any is untriaged.
"verdict" records the parent's call on a diff finding of one round (IDs from "merge"); "stats" shows
review yield by gate level and angle, to calibrate \`brief-init gate\`.`;

function fail(operation, target, cause, recovery) {
	console.error(`review-finding: ${operation} failed for ${target}: ${cause}. ${recovery}`);
	process.exit(1);
}

const [cmd, ...rest] = process.argv.slice(2);
if (!cmd || cmd === "-h" || cmd === "--help") {
	console.log(USAGE);
	process.exit(0);
}

if (cmd === "add") {
	let parsed;
	try {
		parsed = parseArgs({
			args: rest,
			options: {
				brief: { type: "string" },
				severity: { type: "string" },
				origin: { type: "string" },
				file: { type: "string" },
				line: { type: "string" },
				title: { type: "string" },
				proof: { type: "string" },
				fix: { type: "string" },
				angle: { type: "string" },
				reviewer: { type: "string" },
			},
			allowPositionals: false,
		});
	} catch (err) {
		fail("parse arguments", "add", err.message, "Run `review-finding --help` for valid flags.");
	}
	const v = parsed.values;
	for (const key of ["brief", "severity", "origin", "file", "title", "proof"]) {
		if (!v[key]) fail("validate input", `--${key}`, "missing required flag", `Pass --${key} <value>.`);
	}
	if (!SEVERITIES.includes(v.severity)) {
		fail("validate severity", v.severity, `must be one of ${SEVERITIES.join(", ")}`, "Use P0, P1, or P2.");
	}
	if (!ORIGINS.includes(v.origin)) {
		fail("validate origin", v.origin, `must be one of ${ORIGINS.join(", ")}`, "Use diff or existing.");
	}
	let line;
	if (v.line !== undefined) {
		line = Number(v.line);
		if (!Number.isInteger(line) || line < 1) {
			fail("validate line", v.line, "must be a positive integer", "Pass an integer line number or omit --line.");
		}
	}
	const reviewer = v.reviewer || process.env.T3_THREAD_ID || process.env.PI_SESSION_ID || (v.angle ? `cli-${v.angle}` : "cli-default");
	try {
		appendFinding(v.brief, {
			time: new Date().toISOString(),
			reviewer,
			angle: v.angle ?? "",
			severity: v.severity,
			origin: v.origin,
			file: v.file,
			...(line !== undefined ? { line } : {}),
			title: v.title,
			proof: v.proof,
			...(v.fix ? { fix: v.fix } : {}),
		});
	} catch (err) {
		fail("append finding", v.brief, err.message, "Fix the slug or directory permissions and retry.");
	}
	console.log(`Recorded ${v.severity} (${v.origin}) ${v.file}${line ? `:${line}` : ""} for brief "${v.brief}".`);
} else if (cmd === "merge") {
	let parsed;
	try {
		parsed = parseArgs({
			args: rest,
			options: {
				since: { type: "string" },
				json: { type: "boolean", default: false },
			},
			allowPositionals: true,
		});
	} catch (err) {
		fail("parse arguments", "merge", err.message, "Run `review-finding --help` for valid flags.");
	}
	const slug = parsed.positionals[0];
	if (!slug) fail("validate input", "slug", "missing brief slug", "Pass `review-finding merge <slug>`.");
	try {
		const findings = readFindings(slug, parsed.values.since);
		if (parsed.values.json) {
			const caused = mergeFindings(findings.filter((f) => (f.origin ?? "diff") === "diff"));
			const existing = mergeFindings(findings.filter((f) => f.origin === "existing"));
			console.log(JSON.stringify({ slug, count: findings.length, diff: caused, existing }, null, 2));
		} else {
			console.log(renderFindingsReport(slug, findings));
		}
	} catch (err) {
		fail("read findings", slug, err.message, "Check the brief slug and retry.");
	}
} else if (cmd === "existing") {
	let parsed;
	try {
		parsed = parseArgs({
			args: rest,
			options: { json: { type: "boolean", default: false }, check: { type: "boolean", default: false } },
			allowPositionals: true,
		});
	} catch (err) {
		fail("parse arguments", "existing", err.message, "Run `review-finding --help` for valid flags.");
	}
	const target = parsed.positionals[0];
	if (!target) fail("validate input", "group", "missing review group", "Pass `review-finding existing <group>`.");
	let rows;
	try {
		rows = existingLedger(target);
	} catch (err) {
		fail("read pre-existing findings", target, err.message, "Check the group name and retry.");
	}
	console.log(parsed.values.json ? JSON.stringify({ group: groupOf(target), rows }, null, 2) : renderLedger(target, rows).join("\n"));
	if (parsed.values.check && rows.some((r) => r.status === "untriaged")) process.exit(2);
} else if (cmd === "triage") {
	let parsed;
	try {
		parsed = parseArgs({ args: rest, options: { note: { type: "string" } }, allowPositionals: true });
	} catch (err) {
		fail("parse arguments", "triage", err.message, "Run `review-finding --help` for valid flags.");
	}
	const [target, id, decision] = parsed.positionals;
	const note = parsed.values.note;
	if (!target || !id || !decision) fail("validate input", "triage", "missing group, ID, or decision", "Pass `review-finding triage <group> <id> <decision>`.");
	if (!DECISIONS.includes(decision)) fail("validate decision", decision, `must be one of ${DECISIONS.join(", ")}`, "Pick one decision.");
	if (decision === "file" && !note) fail("validate note", id, "file needs the issue URL", "Create the issue after the user approves, then pass --note <url>.");
	if (decision === "drop" && !note) fail("validate note", id, "drop needs a reason", "Pass --note <reason>.");
	try {
		recordTriage(target, {
			time: new Date().toISOString(),
			id,
			decision,
			...(note ? { note } : {}),
			by: process.env.T3_THREAD_ID || process.env.PI_SESSION_ID || "cli",
		});
	} catch (err) {
		fail("record triage", `${target}/${id}`, err.message, "Use an ID from `review-finding existing <group>`.");
	}
	console.log(`Recorded ${decision} for ${id} in group "${groupOf(target)}".`);
} else if (cmd === "verdict") {
	let parsed;
	try {
		parsed = parseArgs({ args: rest, options: { note: { type: "string" } }, allowPositionals: true });
	} catch (err) {
		fail("parse arguments", "verdict", err.message, "Run `review-finding --help` for valid flags.");
	}
	const [slug, id, verdict] = parsed.positionals;
	const note = parsed.values.note;
	if (!slug || !id || !verdict) fail("validate input", "verdict", "missing slug, ID, or verdict", "Pass `review-finding verdict <slug> <id> <verdict>`.");
	if (!VERDICTS.includes(verdict)) fail("validate verdict", verdict, `must be one of ${VERDICTS.join(", ")}`, "Pick one verdict.");
	if (verdict === "noise" && !note) fail("validate note", id, "noise needs a reason", "Pass --note <why the claim is false or out of scope>.");
	try {
		recordVerdict(slug, {
			time: new Date().toISOString(),
			id,
			verdict,
			...(note ? { note } : {}),
			by: process.env.T3_THREAD_ID || process.env.PI_SESSION_ID || "cli",
		});
	} catch (err) {
		fail("record verdict", `${slug}/${id}`, err.message, "Use an ID from the Fix table of `review-finding merge <slug>`.");
	}
	console.log(`Recorded ${verdict} for ${id} in round "${slug}".`);
} else if (cmd === "stats") {
	const json = rest.includes("--json");
	try {
		console.log(json ? JSON.stringify(collectStats(), null, 2) : renderStats());
	} catch (err) {
		fail("compute review stats", "review-findings store", err.message, "Check the store directory and retry.");
	}
} else {
	fail("dispatch command", cmd, "unknown subcommand", "Use `add`, `merge`, `existing`, `triage`, `verdict`, or `stats`.");
}

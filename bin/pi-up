#!/usr/bin/env bash
# Update Pi and its packages, then prove that Pi still starts with every extension loaded.
# Usage: pi-up [--host <ssh-host>]... [--skip-local]
#   --host       also update Pi on that SSH host (repeatable; or PI_UP_HOSTS="air other").
#                The script sends itself over ssh, so the host needs only Pi, not this kit.
#   --skip-local update only the hosts.
# Exit code: 0 when every machine passes, 1 when any update or start check fails.
set -uo pipefail

PKG="@earendil-works/pi-coding-agent"
hosts=(${PI_UP_HOSTS:-})
local_run=1
while [ $# -gt 0 ]; do
  case "$1" in
    --host) hosts+=("$2"); shift 2 ;;
    --skip-local) local_run=0; shift ;;
    -h|--help) sed -n 2,7p "$0"; exit 0 ;;
    *) echo "pi-up: unknown argument '$1'. Run pi-up --help." >&2; exit 2 ;;
  esac
done

update_here() {
  local name before after pi_cli prefix out status=0
  name="$(hostname -s)"
  if ! command -v pi >/dev/null 2>&1; then
    echo "[$name] FAIL: pi is not on PATH. Install Pi first."; return 1
  fi
  before="$(pi --version 2>/dev/null)"
  pi_cli="$(readlink -f "$(command -v pi)")"

  # Pi in a private npm prefix (for example ~/.pi/agent/npm) cannot self-update; update the prefix.
  prefix="${pi_cli%%/node_modules/$PKG/*}"
  if [ "$prefix" != "$pi_cli" ] && [ -f "$prefix/package.json" ] && grep -q "\"$PKG\"" "$prefix/package.json"; then
    if ! out="$(cd "$prefix" && npm install "$PKG@latest" 2>&1)"; then
      echo "[$name] FAIL: npm install $PKG in $prefix:"; echo "$out" | tail -5; return 1
    fi
    # Another package in the prefix can also ship a `pi` bin (for example the old
    # @mariozechner/pi-coding-agent alias), and npm may link .bin/pi to it. Relink to $PKG.
    case "$(readlink -f "$(command -v pi)")" in
      */node_modules/$PKG/*) ;;
      *) (cd "$prefix" && npm rebuild "$PKG" --ignore-scripts >/dev/null 2>&1) ;;
    esac
  else
    if ! out="$(pi update --self 2>&1)"; then
      echo "[$name] FAIL: pi update --self:"; echo "$out" | tail -5; return 1
    fi
  fi
  after="$(pi --version 2>/dev/null)"
  if [ -z "$after" ]; then
    echo "[$name] FAIL: pi does not start after the update. Run 'npm rebuild $PKG --ignore-scripts' in $prefix."; return 1
  fi
  echo "[$name] pi $before -> $after"

  if ! out="$(pi update --extensions 2>&1)"; then
    echo "[$name] FAIL: pi update --extensions:"; echo "$out" | tail -8; status=1
  fi
  local summary
  summary="$(echo "$out" | grep -iE 'added|changed|updated|up to date|warning' | tail -3 | tr '\n' ' ')"

  # Print mode reports extension load errors and package warnings on stderr and exits 1 on errors.
  local check_out check_err rc
  check_err="$(mktemp)"
  check_out="$(cd /tmp && pi -p --no-session "Reply with exactly: OK" 2>"$check_err")"; rc=$?
  if [ $rc -ne 0 ] || ! echo "$check_out" | grep -q 'OK'; then
    echo "[$name] FAIL: Pi start check (exit $rc):"; sed 's/^/    /' "$check_err" | tail -15; status=1
  elif [ -s "$check_err" ]; then
    echo "[$name] WARN: Pi starts, with messages:"; sed 's/^/    /' "$check_err" | tail -15
  fi
  rm -f "$check_err"

  [ $status -eq 0 ] && echo "[$name] OK: ${summary:-packages up to date.}"
  return $status
}

overall=0
if [ $local_run -eq 1 ]; then
  # </dev/null: over ssh this script arrives on stdin, and pi or npm must not read the rest of it.
  update_here </dev/null || overall=1
fi
for host in ${hosts[@]+"${hosts[@]}"}; do
  # A login shell gives the remote PATH (Homebrew, nvm, mise). The script travels on stdin.
  if ! ssh -o ConnectTimeout=15 "$host" 'exec "${SHELL:-/bin/bash}" -lc "PI_UP_HOSTS= bash -s"' < "$0" 2>&1 | sed "s/^/($host) /"; then
    overall=1
  fi
done
exit $overall

#!/usr/bin/env bash
# Share Pi's global rules (AGENTS.md) and skills with the other agents that T3 Code runs:
# Claude Code, Codex, and Antigravity. Safe to run again; run it after you add a skill or edit AGENTS.md.
#   Claude Code: ~/.claude/CLAUDE.md imports the rules live; ~/.claude/skills/<name> links to each skill.
#   Codex:       ~/.codex/AGENTS.md is a generated copy; it already finds the kit skills in ~/.agents/skills/pi,
#                and ~/.codex/skills/<name> links to the other Pi skills.
#   Antigravity: ~/.gemini/GEMINI.md is a generated copy; ~/.gemini/antigravity/skills/<name> links to each skill.
# A file or folder that this script replaces goes to a backup file or to the macOS Trash.
set -euo pipefail

KIT_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
RULES="$AGENT_DIR/AGENTS.md"
ADAPTER="$KIT_DIR/providers/ADAPTER.md"
MARK="<!-- generated by pi-sync-providers: edit $RULES or $ADAPTER, then run pi-sync-providers -->"

# Real paths of the skills that Pi settings.json turns off with a "-" entry.
excluded_skills() {
  node -e '
    const fs = require("node:fs"), os = require("node:os");
    const file = process.argv[1];
    const skills = fs.existsSync(file) ? JSON.parse(fs.readFileSync(file, "utf8")).skills ?? [] : [];
    for (const s of skills.filter((s) => s.startsWith("-"))) {
      try { console.log(fs.realpathSync(s.slice(1).replace(/^~/, os.homedir()))); } catch {}
    }' "$AGENT_DIR/settings.json"
}

# Prints one skill folder per line: the kit skills, then the local Pi skills.
pi_skills() {
  local excluded dir
  excluded="$(excluded_skills)"
  for dir in "$KIT_DIR"/skills/*/ "$AGENT_DIR"/skills/*/; do
    dir="$(readlink -f "$dir")"
    [ -f "$dir/SKILL.md" ] || continue
    grep -qxF "$dir" <<<"$excluded" && continue
    echo "$dir"
  done
}

link_skill() {
  local src="$1" dest="$2/$(basename "$1")"
  if [ -L "$dest" ] && [ "$(readlink -f "$dest")" = "$src" ]; then return; fi
  if [ -L "$dest" ]; then
    echo "  replaced link $dest (was -> $(readlink "$dest"))"; rm "$dest"
  elif [ -e "$dest" ]; then
    echo "  moved old copy $dest to the Trash"; trash "$dest"
  else
    echo "  linked $dest"
  fi
  ln -s "$src" "$dest"
}

# Removes links in a skills folder that point into Pi and no longer resolve.
prune_links() {
  local link
  for link in "$1"/*; do
    [ -L "$link" ] && [ ! -e "$link" ] || continue
    case "$(readlink "$link")" in
      "$AGENT_DIR"/* | "$KIT_DIR"/*) echo "  removed dead link $link"; rm "$link" ;;
    esac
  done
}

sync_skills() {
  local dir="$1" only_local="$2" src
  [ -d "$(dirname "$dir")" ] || { echo "==> skipped $dir: the agent is not installed"; return; }
  echo "==> skills in $dir"
  mkdir -p "$dir"
  prune_links "$dir"
  while read -r src; do
    if [ "$only_local" = 1 ] && [[ "$src" == "$(readlink -f "$KIT_DIR/skills")"/* ]]; then continue; fi
    link_skill "$src" "$dir"
  done < <(pi_skills)
}

write_rules() {
  local dest="$1" content="$2"
  [ -d "$(dirname "$dest")" ] || { echo "==> skipped $dest: the agent is not installed"; return; }
  if [ -s "$dest" ] && ! head -1 "$dest" | grep -qF "<!-- generated by pi-sync-providers"; then
    cp "$dest" "$dest.pre-pi-sync.$(date +%Y%m%d%H%M%S)"
    echo "==> backed up $dest"
  fi
  printf '%s\n' "$content" >"$dest"
  echo "==> wrote $dest"
}

[ -f "$RULES" ] || { echo "pi-sync-providers: $RULES is missing. Run install.sh first." >&2; exit 1; }
copy="$(printf '%s\n\n%s\n\n%s' "$MARK" "$(cat "$RULES")" "$(cat "$ADAPTER")")"
write_rules "$HOME/.claude/CLAUDE.md" "$(printf '%s\n@%s\n@%s' "$MARK" "$RULES" "$ADAPTER")"
write_rules "$HOME/.codex/AGENTS.md" "$copy"
write_rules "$HOME/.gemini/GEMINI.md" "$copy"

sync_bins() {
  local bin_dir="$HOME/.local/bin" src dest
  mkdir -p "$bin_dir"
  echo "==> CLIs in $bin_dir"
  for src in "$KIT_DIR"/bin/*; do
    [ -f "$src" ] && [ -x "$src" ] || continue
    dest="$bin_dir/$(basename "$src")"
    if [ -L "$dest" ] && [ "$(readlink -f "$dest")" = "$(readlink -f "$src")" ]; then continue; fi
    if [ -L "$dest" ]; then
      echo "  replaced link $dest"; rm "$dest"
    elif [ -e "$dest" ]; then
      echo "  skipped $dest (non-symlink file exists)"; continue
    else
      echo "  linked $dest"
    fi
    ln -s "$src" "$dest"
  done
}

sync_claude_hooks() {
  local settings="$HOME/.claude/settings.json" hook="$KIT_DIR/hooks/claude-pretool.ts" node_bin
  [ -d "$HOME/.claude" ] && [ -f "$hook" ] || return 0
  node_bin="$(command -v node)"
  node - "$settings" "$hook" "$node_bin" <<'EOF'
const fs = require("node:fs");
const [settingsPath, hookPath, nodeBin] = process.argv.slice(2);
const sq = (s) => `'${s.replace(/'/g, "'\\''")}'`;
const settings = fs.existsSync(settingsPath) ? JSON.parse(fs.readFileSync(settingsPath, "utf8")) : {};
settings.hooks = settings.hooks && typeof settings.hooks === "object" ? settings.hooks : {};
const pre = Array.isArray(settings.hooks.PreToolUse) ? settings.hooks.PreToolUse : [];
const command = `${sq(nodeBin)} ${sq(hookPath)}`;
const matcher = "Bash|AskUserQuestion|ask_user_question|mcp__t3-code__ask_user_question|mcp__t3_code__ask_user_question|mcp__t3-code__delegate_task|mcp__t3_code__delegate_task";
const filtered = pre.filter((entry) => !entry?.hooks?.some((h) => typeof h?.command === "string" && h.command.includes("claude-pretool.ts")));
filtered.push({ matcher, hooks: [{ type: "command", command }] });
settings.hooks.PreToolUse = filtered;
fs.writeFileSync(settingsPath, JSON.stringify(settings, null, 2) + "\n");
console.log(`==> wired Claude PreToolUse hook in ${settingsPath}`);
EOF
}

kit_in_agents="$([ "$(readlink -f "$HOME/.agents/skills/pi")" = "$(readlink -f "$KIT_DIR/skills")" ] && echo 1 || echo 0)"
sync_skills "$HOME/.claude/skills" 0
sync_skills "$HOME/.codex/skills" "$kit_in_agents"
sync_skills "$HOME/.gemini/antigravity/skills" 0
sync_bins
sync_claude_hooks
echo "Done. Start a new thread in T3 Code to load the changes."
